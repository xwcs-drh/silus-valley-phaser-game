{
    "name": "phaser-sv",
    "description": "A Phaser 3 TypeScript template using Vite.",
    "version": "1.0.0",
    "repository": {
        "type": "git",
        "url": "git+git@github.com:xwcs-drh/silus-valley-phaser-game.git"
    },
